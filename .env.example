APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# GitHub OAuth (kite feature). Register an OAuth app at https://github.com/settings/developers
# with the callback below. Grants `repo` scope; tokens are stored encrypted at rest.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Defaults to APP_URL + /auth/github/callback when left blank.
GITHUB_REDIRECT_URI=

# AI code-analysis backend (see config/services.php 'analyzer').
# Leave AI_ANALYZER_ENDPOINT blank to run on the NullCodeAnalyzer (no AI required).
# Set an endpoint to enable it — same app works against Langflow / LangChain / LangGraph.
AI_ANALYZER=null
AI_ANALYZER_ENDPOINT=
AI_ANALYZER_API_KEY=
AI_ANALYZER_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"

# Shared secret the other sites present when POSTing signups to
# /api/subscribers. Blank closes the endpoint. Must match NEWSLETTER_TOKEN
# in the calling app (clever).
NEWSLETTER_INGEST_TOKEN=
